## Copy this file to neo4j_credentials.env, fill in real values, then upload
## neo4j_credentials.env into the Jupyter session next to the notebook.
## neo4j_credentials.env is git-ignored -- never commit real credentials.

## Ask your instructor for these three values. IYP_READ_URI is either an
## in-cluster NRP service address (if your JupyterHub runs in the same
## namespace as the instance) or bolt://localhost:7687 (if you're connecting
## through a kubectl port-forward tunnel -- see Datasets.md#connecting).
IYP_READ_URI=bolt://localhost:7687
IYP_READ_USER=
IYP_READ_PASSWORD=
